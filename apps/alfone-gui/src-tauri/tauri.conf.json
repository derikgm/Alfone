{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alfone",
  "version": "0.1.0",
  "identifier": "dev.alfone.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Alfone",
        "width": 1040,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Comparte teclado, ratón, audio y pantallas",
    "longDescription": "Alfone comparte teclado y ratón entre computadoras y añade audio y una segunda pantalla por la red local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
